{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newbatteries.github.io/data/battery-record-schema.json",
  "title": "NewBatteries Governed Battery Record Schema",
  "type": "object",
  "required": [
    "identification",
    "physical",
    "electrical",
    "chemistry",
    "australianContext",
    "replacementPathway",
    "recordGovernance"
  ],
  "properties": {
    "identification": {
      "type": "object",
      "required": [
        "recordId",
        "canonicalCode",
        "category"
      ],
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "canonicalCode": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        },
        "manufacturerModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "standardFamily": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "coin_cell",
            "button_cell",
            "household_primary",
            "household_rechargeable",
            "automotive_12v",
            "automotive_start_stop",
            "motorcycle",
            "power_tool_platform",
            "caravan_marine",
            "residential_storage",
            "specialist_only"
          ]
        },
        "subcategory": {
          "type": [
            "string",
            "null"
          ]
        },
        "applicationClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "marketRegions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "physical": {
      "type": "object",
      "properties": {
        "lengthMm": {
          "$ref": "#/$defs/technicalField"
        },
        "widthMm": {
          "$ref": "#/$defs/technicalField"
        },
        "heightMm": {
          "$ref": "#/$defs/technicalField"
        },
        "diameterMm": {
          "$ref": "#/$defs/technicalField"
        },
        "thicknessMm": {
          "$ref": "#/$defs/technicalField"
        },
        "terminalType": {
          "$ref": "#/$defs/technicalField"
        },
        "terminalLayout": {
          "$ref": "#/$defs/technicalField"
        },
        "polarityOrientation": {
          "$ref": "#/$defs/technicalField"
        },
        "connectorGeometry": {
          "$ref": "#/$defs/technicalField"
        },
        "connectorKeying": {
          "$ref": "#/$defs/technicalField"
        },
        "holdDownType": {
          "$ref": "#/$defs/technicalField"
        },
        "baseProfile": {
          "$ref": "#/$defs/technicalField"
        },
        "mountingProfile": {
          "$ref": "#/$defs/technicalField"
        },
        "weightKg": {
          "$ref": "#/$defs/technicalField"
        }
      },
      "additionalProperties": false
    },
    "electrical": {
      "type": "object",
      "properties": {
        "nominalVoltage": {
          "$ref": "#/$defs/technicalField"
        },
        "capacityAh": {
          "$ref": "#/$defs/technicalField"
        },
        "capacityMah": {
          "$ref": "#/$defs/technicalField"
        },
        "capacityTestConditions": {
          "$ref": "#/$defs/technicalField"
        },
        "cca": {
          "$ref": "#/$defs/technicalField"
        },
        "ccaTestStandard": {
          "$ref": "#/$defs/technicalField"
        },
        "reserveCapacityMinutes": {
          "$ref": "#/$defs/technicalField"
        },
        "continuousDischargeA": {
          "$ref": "#/$defs/technicalField"
        },
        "peakDischargeA": {
          "$ref": "#/$defs/technicalField"
        },
        "rechargeable": {
          "$ref": "#/$defs/technicalField"
        }
      },
      "additionalProperties": false
    },
    "chemistry": {
      "type": "object",
      "properties": {
        "chemistryFamily": {
          "$ref": "#/$defs/technicalField"
        },
        "chemistrySubtype": {
          "$ref": "#/$defs/technicalField"
        },
        "chargingProfile": {
          "$ref": "#/$defs/technicalField"
        },
        "bmsRequired": {
          "$ref": "#/$defs/technicalField"
        },
        "batteryCommunicationRequired": {
          "$ref": "#/$defs/technicalField"
        }
      },
      "additionalProperties": false
    },
    "australianContext": {
      "type": "object",
      "properties": {
        "australianAvailability": {
          "$ref": "#/$defs/technicalField"
        },
        "cecListingRelevant": {
          "$ref": "#/$defs/technicalField"
        },
        "cecListingStatus": {
          "$ref": "#/$defs/technicalField"
        },
        "eessRelevant": {
          "$ref": "#/$defs/technicalField"
        },
        "recallStatus": {
          "$ref": "#/$defs/technicalField"
        },
        "specialistInstallationRequired": {
          "$ref": "#/$defs/technicalField"
        },
        "recyclingPathway": {
          "$ref": "#/$defs/technicalField"
        },
        "stateSpecificRequirementsPossible": {
          "$ref": "#/$defs/technicalField"
        }
      },
      "additionalProperties": false
    },
    "replacementPathway": {
      "type": "object",
      "properties": {
        "consumerReplaceable": {
          "$ref": "#/$defs/technicalField"
        },
        "supplierConfirmationRequired": {
          "$ref": "#/$defs/technicalField"
        },
        "manufacturerConfirmationRequired": {
          "$ref": "#/$defs/technicalField"
        },
        "qualifiedInstallerRequired": {
          "$ref": "#/$defs/technicalField"
        },
        "specialistOnly": {
          "$ref": "#/$defs/technicalField"
        }
      },
      "additionalProperties": false
    },
    "recordGovernance": {
      "type": "object",
      "required": [
        "recordStatus",
        "createdAt",
        "updatedAt",
        "version",
        "reviewDueAt",
        "approvedAt",
        "approvedBy",
        "reviewNotes",
        "publicEligibility",
        "compatibilityEngineEligibility"
      ],
      "properties": {
        "recordStatus": {
          "type": "string",
          "enum": [
            "draft",
            "under_review",
            "reviewed",
            "approved",
            "disputed",
            "deprecated",
            "retired"
          ]
        },
        "previousStatus": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "draft",
            "under_review",
            "reviewed",
            "approved",
            "disputed",
            "deprecated",
            "retired",
            null
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "reviewDueAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "disputeNotes": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "changeHistory": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reviewNotes": {
          "type": "string"
        },
        "publicEligibility": {
          "type": "boolean"
        },
        "compatibilityEngineEligibility": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "technicalField": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "evidenceConfidence",
        "sourceIds",
        "verifiedAt",
        "verifiedBy",
        "notes",
        "conflict"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceConfidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "verifiedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        },
        "conflict": {
          "$ref": "#/$defs/fieldConflict"
        }
      },
      "additionalProperties": false
    },
    "fieldConflict": {
      "type": "object",
      "required": [
        "status",
        "acceptedValue",
        "competingValues",
        "resolutionNotes",
        "reviewer",
        "resolvedAt"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "unresolved",
            "resolved",
            "source_superseded",
            "category_variant"
          ]
        },
        "acceptedValue": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "competingValues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "sourceIds"
            ],
            "properties": {
              "value": {
                "type": [
                  "number",
                  "string",
                  "boolean",
                  "null"
                ]
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "resolutionNotes": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolvedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "categoryProfiles": {
    "coin_cell": {
      "requiredFields": [
        "identification.canonicalCode",
        "identification.category",
        "physical.diameterMm",
        "physical.thicknessMm",
        "electrical.nominalVoltage",
        "chemistry.chemistryFamily",
        "electrical.rechargeable"
      ],
      "optionalFields": [
        "physical.weightKg",
        "australianContext.recallStatus"
      ],
      "prohibitedAssumptions": [
        "assume_interchangeability_by_prefix_only"
      ],
      "preferredSourceTypes": [
        "manufacturer_technical_catalogue",
        "recognised_standard",
        "oem_equipment_manual"
      ],
      "specialistReviewRequired": false,
      "consumerReplacementClassification": "consumer_replaceable",
      "compatibilityLayers": [
        "identity",
        "physical_fit",
        "electrical_baseline"
      ]
    },
    "button_cell": {
      "requiredFields": [
        "identification.canonicalCode",
        "identification.category",
        "physical.diameterMm",
        "physical.thicknessMm",
        "electrical.nominalVoltage",
        "chemistry.chemistryFamily",
        "electrical.rechargeable"
      ],
      "optionalFields": [
        "physical.weightKg"
      ],
      "prohibitedAssumptions": [
        "assume_ag_lx_equals_srx_without_evidence"
      ],
      "preferredSourceTypes": [
        "manufacturer_technical_catalogue",
        "recognised_standard"
      ],
      "specialistReviewRequired": false,
      "consumerReplacementClassification": "consumer_replaceable",
      "compatibilityLayers": [
        "identity",
        "physical_fit",
        "electrical_baseline"
      ]
    },
    "household_primary": {
      "requiredFields": [
        "identification.canonicalCode",
        "identification.category",
        "electrical.nominalVoltage",
        "chemistry.chemistryFamily"
      ],
      "optionalFields": [
        "electrical.capacityMah",
        "physical.lengthMm",
        "physical.diameterMm"
      ],
      "prohibitedAssumptions": [
        "assume_rechargeable_substitution_without_explicit_support"
      ],
      "preferredSourceTypes": [
        "manufacturer_technical_catalogue",
        "recognised_standard"
      ],
      "specialistReviewRequired": false,
      "consumerReplacementClassification": "consumer_replaceable",
      "compatibilityLayers": [
        "identity",
        "electrical_baseline"
      ]
    },
    "household_rechargeable": {
      "requiredFields": [
        "identification.canonicalCode",
        "identification.category",
        "electrical.nominalVoltage",
        "chemistry.chemistryFamily",
        "electrical.rechargeable"
      ],
      "optionalFields": [
        "electrical.capacityMah",
        "chemistry.chargingProfile"
      ],
      "prohibitedAssumptions": [
        "assume_charger_compatibility_without_evidence"
      ],
      "preferredSourceTypes": [
        "manufacturer_technical_catalogue",
        "manufacturer_authorised_fitment_guide"
      ],
      "specialistReviewRequired": false,
      "consumerReplacementClassification": "consumer_replaceable_with_guidance",
      "compatibilityLayers": [
        "identity",
        "electrical_baseline",
        "charging_constraints"
      ]
    },
    "automotive_12v": {
      "requiredFields": [
        "identification.standardFamily",
        "identification.category",
        "physical.lengthMm",
        "physical.widthMm",
        "physical.heightMm",
        "physical.terminalType",
        "physical.terminalLayout",
        "physical.polarityOrientation",
        "physical.holdDownType",
        "physical.baseProfile",
        "electrical.nominalVoltage",
        "chemistry.chemistryFamily"
      ],
      "optionalFields": [
        "electrical.reserveCapacityMinutes",
        "physical.holdDownType"
      ],
      "prohibitedAssumptions": [
        "assume_same_case_size_means_terminal_compatibility"
      ],
      "preferredSourceTypes": [
        "manufacturer_technical_catalogue",
        "manufacturer_authorised_fitment_guide",
        "commercial_fitment_database"
      ],
      "specialistReviewRequired": true,
      "consumerReplacementClassification": "consumer_or_installer_check_required",
      "compatibilityLayers": [
        "physical_fit",
        "terminal_layout",
        "electrical_performance"
      ]
    },
    "automotive_start_stop": {
      "requiredFields": [
        "identification.standardFamily",
        "identification.category",
        "electrical.nominalVoltage",
        "electrical.cca",
        "chemistry.chemistryFamily",
        "replacementPathway.supplierConfirmationRequired"
      ],
      "optionalFields": [
        "electrical.reserveCapacityMinutes",
        "chemistry.batteryCommunicationRequired"
      ],
      "prohibitedAssumptions": [
        "assume_agm_efb_equivalence_without_evidence"
      ],
      "preferredSourceTypes": [
        "manufacturer_technical_catalogue",
        "commercial_fitment_database"
      ],
      "specialistReviewRequired": true,
      "consumerReplacementClassification": "installer_recommended",
      "compatibilityLayers": [
        "electrical_performance",
        "vehicle_system_constraints"
      ]
    },
    "motorcycle": {
      "requiredFields": [
        "identification.standardFamily",
        "identification.category",
        "physical.lengthMm",
        "physical.widthMm",
        "physical.heightMm",
        "electrical.nominalVoltage",
        "electrical.cca"
      ],
      "optionalFields": [
        "physical.terminalLayout",
        "chemistry.chemistryFamily"
      ],
      "prohibitedAssumptions": [
        "assume_case_match_without_polarity_confirmation"
      ],
      "preferredSourceTypes": [
        "manufacturer_technical_catalogue",
        "manufacturer_authorised_fitment_guide"
      ],
      "specialistReviewRequired": true,
      "consumerReplacementClassification": "consumer_with_verification",
      "compatibilityLayers": [
        "physical_fit",
        "polarity",
        "electrical_performance"
      ]
    },
    "power_tool_platform": {
      "requiredFields": [
        "identification.canonicalCode",
        "identification.category",
        "electrical.nominalVoltage",
        "chemistry.chemistryFamily",
        "chemistry.batteryCommunicationRequired"
      ],
      "optionalFields": [
        "physical.connectorGeometry",
        "physical.connectorKeying"
      ],
      "prohibitedAssumptions": [
        "assume_cross_brand_platform_compatibility"
      ],
      "preferredSourceTypes": [
        "manufacturer_technical_catalogue",
        "oem_equipment_manual"
      ],
      "specialistReviewRequired": true,
      "consumerReplacementClassification": "platform_locked",
      "compatibilityLayers": [
        "platform_identity",
        "connector_profile",
        "communication_constraints"
      ]
    },
    "caravan_marine": {
      "requiredFields": [
        "identification.standardFamily",
        "identification.category",
        "electrical.nominalVoltage",
        "chemistry.chemistryFamily",
        "replacementPathway.qualifiedInstallerRequired"
      ],
      "optionalFields": [
        "electrical.capacityAh",
        "electrical.continuousDischargeA"
      ],
      "prohibitedAssumptions": [
        "assume_drop_in_replacement_without_system_review"
      ],
      "preferredSourceTypes": [
        "manufacturer_technical_catalogue",
        "oem_equipment_manual",
        "recognised_standard"
      ],
      "specialistReviewRequired": true,
      "consumerReplacementClassification": "specialist_recommended",
      "compatibilityLayers": [
        "electrical_profile",
        "installation_constraints",
        "safety_context"
      ]
    },
    "residential_storage": {
      "requiredFields": [
        "identification.canonicalCode",
        "identification.category",
        "electrical.nominalVoltage",
        "chemistry.chemistryFamily",
        "australianContext.cecListingRelevant",
        "replacementPathway.specialistOnly"
      ],
      "optionalFields": [
        "australianContext.cecListingStatus",
        "chemistry.bmsRequired"
      ],
      "prohibitedAssumptions": [
        "assume_inverter_or_system_compatibility"
      ],
      "preferredSourceTypes": [
        "approved_product_list",
        "government_regulator",
        "manufacturer_technical_catalogue"
      ],
      "specialistReviewRequired": true,
      "consumerReplacementClassification": "specialist_only",
      "compatibilityLayers": [
        "program_eligibility",
        "system_integration",
        "installation_compliance"
      ]
    },
    "specialist_only": {
      "requiredFields": [
        "identification.canonicalCode",
        "identification.category",
        "replacementPathway.specialistOnly"
      ],
      "optionalFields": [
        "australianContext.specialistInstallationRequired"
      ],
      "prohibitedAssumptions": [
        "assume_consumer_replacement_pathway"
      ],
      "preferredSourceTypes": [
        "manufacturer_technical_catalogue",
        "government_regulator"
      ],
      "specialistReviewRequired": true,
      "consumerReplacementClassification": "specialist_only",
      "compatibilityLayers": [
        "specialist_review_gate"
      ]
    }
  },
  "approvalCriteria": {
    "requirements": [
      "unambiguous_identity",
      "category_required_fields_complete_or_not_applicable",
      "traceable_evidence_for_required_technical_values",
      "source_usage_rights_considered",
      "conflicts_resolved_or_disclosed",
      "record_status_approved",
      "version_assigned",
      "review_date_recorded",
      "no_ai_inference_only_values"
    ],
    "minimumEvidenceThresholds": {
      "coin_button": "At least one Level 1-3 source for identity and key dimensions/voltage.",
      "automotive_families": "At least two independent sources including one Level 1-4 source.",
      "power_tool_platforms": "Platform identity and communication constraints supported by Level 1-4 evidence.",
      "household": "Identity/chemistry/voltage supported by Level 1-4 evidence.",
      "caravan_marine": "Installation constraints and electrical profile supported by Level 1-4 evidence and risk notes."
    }
  }
}
